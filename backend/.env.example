# Backend local development template. Copy to an ignored backend/.env or root .env.
APP_ENV=development
DATABASE_URL=sqlite:///./lessonfoundry-dev.sqlite3
WORKER_DATABASE_URL=
AUTH_MODE=local
FRONTEND_ORIGIN=http://localhost:3000
LOCAL_TEACHER_TOKEN=
LOCAL_STUDENT_TOKEN=

LLM_PROVIDER=mock
REAL_LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.local-files
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SOURCE_BUCKET=sources

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
