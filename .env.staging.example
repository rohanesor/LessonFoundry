# Dedicated staging project only. Copy to .env.staging (git-ignored).
APP_ENV=staging
AUTH_MODE=supabase
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SOURCE_BUCKET=sources
# Provisioning/test administration only. Never sent by the runtime Storage adapter.
SUPABASE_SERVICE_ROLE_KEY=
# NOINHERIT NOBYPASSRLS API login: member of lessonfoundry_api + lessonfoundry_student.
DATABASE_URL=
# Separate worker login: member of lessonfoundry_worker only.
WORKER_DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
LLM_PROVIDER=mock
STAGING_API_URL=http://127.0.0.1:8000
STAGING_USER_A_EMAIL=
STAGING_USER_A_PASSWORD=
STAGING_USER_B_EMAIL=
STAGING_USER_B_PASSWORD=
STAGING_WEB_URL=http://localhost:3000
