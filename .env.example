# LessonFoundry local development configuration. Copy to an ignored .env file.
# Do not put real credentials in this tracked template.
APP_ENV=development
DATABASE_URL=sqlite:///./lessonfoundry-dev.sqlite3
WORKER_DATABASE_URL=
AUTH_MODE=local
FRONTEND_ORIGIN=http://localhost:3000
RATE_LIMIT=0

# Safe defaults: no external LLM calls.
LLM_PROVIDER=mock
REAL_LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local tokens are development-only values supplied outside source control.
LOCAL_TEACHER_TOKEN=
LOCAL_STUDENT_TOKEN=

# local | supabase | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.local-files

# S3 uses the AWS SDK default credential provider chain (EC2 IAM role preferred).
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Backend-only Supabase configuration. Never expose the service-role key to Next.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SOURCE_BUCKET=sources

# Browser-safe Supabase configuration only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Configure Google OAuth secrets in Supabase/provider deployment configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
