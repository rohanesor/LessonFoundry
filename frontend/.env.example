# Server-only backend reverse-proxy target (set before next build):
BACKEND_URL=http://127.0.0.1:8000
# Set only for Supabase login; anon/publishable key is public, never use service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sessions are persisted/refreshed by the single Supabase client in lib/auth.ts.
# Never use a secret/service-role key as NEXT_PUBLIC_SUPABASE_ANON_KEY.
